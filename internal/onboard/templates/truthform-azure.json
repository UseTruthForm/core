{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Truthform's access to one subscription, written by truthform permissions --platform azure. Deploy it as a deployment stack: deleting the stack with --action-on-unmanage deleteAll removes the role assignments. A plain deployment would not: deleting a deployment leaves what it created in place."
  },
  "parameters": {
    "principalId": {
      "type": "string",
      "metadata": { "description": "Object ID of the user, group or service principal that runs Truthform." }
    },
    "principalType": {
      "type": "string",
      "allowedValues": [ "User", "Group", "ServicePrincipal" ],
      "defaultValue": "ServicePrincipal"
    },
    "access": {
      "type": "string",
      "allowedValues": [ "capture", "restore" ],
      "defaultValue": "capture",
      "metadata": { "description": "capture: Reader. restore: Contributor and User Access Administrator (role assignments and locks need the second)." }
    }
  },
  "variables": {
    "reader": "acdd72a7-3385-48ef-bd42-f606fba81ae7",
    "contributor": "b24988ac-6180-42a0-ab88-20f7382dd24c",
    "userAccessAdministrator": "18d7d88d-d35e-4fb5-a5c3-7773c20a72d9",
    "roles": "[if(equals(parameters('access'), 'restore'), createArray(variables('contributor'), variables('userAccessAdministrator')), createArray(variables('reader')))]"
  },
  "resources": [
    {
      "copy": { "name": "assignments", "count": "[length(variables('roles'))]" },
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(subscription().id, parameters('principalId'), variables('roles')[copyIndex()])]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('roles')[copyIndex()])]",
        "principalId": "[parameters('principalId')]",
        "principalType": "[parameters('principalType')]",
        "description": "[format('Truthform {0} access (truthform permissions)', parameters('access'))]"
      }
    }
  ]
}
