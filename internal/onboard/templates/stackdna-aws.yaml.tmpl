AWSTemplateFormatVersion: "2010-09-09"
# The role StackDNA runs as in one AWS account. Written by
# "stackdna permissions --platform aws"; deploying it is one stack, and
# deleting the stack removes everything it granted.
#
# Deliberately not here:
# - No hand-written list of reads. AWS's managed ReadOnlyAccess does not
#   cover every service: alone it was refused 87 of about 1,500 types in a
#   sandbox (2026-10-23). The capture role also gets the policies named
#   ReadsAddOn below: the reads the CloudFormation registry's list and read
#   handlers name that ReadOnlyAccess ({{.ReadOnlyVersion}}) lacks, kept to
#   reads of configuration, generated by scripts/gen-aws-reads.sh. A type
#   needing anything else (kms:Decrypt, a write a schema lists as a read)
#   stays refused, and stackdna check says which.
# - No IAM write for restore. PowerUserAccess restores every service except
#   IAM; restoring IAM roles and policies needs a grant scoped by the
#   customer to the names being restored (docs/permissions.md).
# - No permission for StackDNA to change this role or its trust: the role
#   cannot widen itself.
Description: StackDNA access role (stackdna permissions). Delete this stack to remove it.

Parameters:
  TrustedPrincipalArn:
    Type: String
    Description: The IAM user or role that runs StackDNA and may assume this role.
    # A whole account (":root") is accepted only because AWS accepts it;
    # stackdna permissions warns when given one, since it lets every
    # principal in that account that is allowed sts:AssumeRole in.
    AllowedPattern: '^arn:aws[a-z-]*:iam::[0-9]{12}:(root|user/.+|role/.+)$'
  ExternalId:
    Type: String
    Default: ""
    Description: Required by the trust when set. Use one when the trusted principal is in another account.
  Access:
    Type: String
    AllowedValues: [capture, restore]
    Default: capture
    Description: capture is read-only; restore adds PowerUserAccess.
  RoleName:
    Type: String
    Default: stackdna-reader
    AllowedPattern: '^[A-Za-z0-9+=,.@_-]{1,64}$'

Conditions:
  HasExternalId: !Not [!Equals [!Ref ExternalId, ""]]
  Restore: !Equals [!Ref Access, restore]
  # PowerUserAccess already reads every service the add-on covers.
  Capture: !Equals [!Ref Access, capture]

Resources:
  Role:
    Type: AWS::IAM::Role
    Properties:
      RoleName: !Ref RoleName
      Description: !Sub "StackDNA ${Access} access (stackdna permissions)"
      AssumeRolePolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Principal:
              AWS: !Ref TrustedPrincipalArn
            Action: sts:AssumeRole
            Condition: !If
              - HasExternalId
              - StringEquals:
                  sts:ExternalId: !Ref ExternalId
              - !Ref AWS::NoValue
      ManagedPolicyArns:
        - !Sub arn:${AWS::Partition}:iam::aws:policy/ReadOnlyAccess
        - !If [Restore, !Sub "arn:${AWS::Partition}:iam::aws:policy/PowerUserAccess", !Ref AWS::NoValue]
      Tags:
        - Key: managed-by
          Value: stackdna-permissions

{{- range $i, $actions := .Chunks}}

  ReadsAddOn{{$i}}:
    Type: AWS::IAM::ManagedPolicy
    Condition: Capture
    Properties:
      ManagedPolicyName: !Sub "${RoleName}-reads-{{$i}}"
      Description: Reads StackDNA needs that ReadOnlyAccess lacks (generated; stackdna permissions)
      Roles: [!Ref Role]
      PolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Resource: "*"
            Action:
{{- range $actions}}
              - {{q .}}
{{- end}}
{{- end}}

Outputs:
  RoleArn:
    Value: !GetAtt Role.Arn
